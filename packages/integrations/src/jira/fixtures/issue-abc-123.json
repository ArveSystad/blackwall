    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "As an " },
            { "type": "text", "text": "accountant", "marks": [{ "type": "strong" }] },
            { "type": "text", "text": " I want to export invoices as CSV, see " },
            {
              "type": "text",
              "text": "the spec",
              "marks": [{ "type": "link", "attrs": { "href": "https://wiki.acme.test/csv" } }]
            },
            { "type": "text", "text": "." },
            { "type": "hardBreak" },
            { "type": "text", "text": "Use " },
            { "type": "text", "text": "InvoiceExporter", "marks": [{ "type": "code" }] },
            { "type": "text", "text": "." }
          ]
        },
        {
          "type": "heading",
          "attrs": { "level": 2 },
          "content": [{ "type": "text", "text": "Acceptance criteria" }]
        },
        {
          "type": "orderedList",
          "attrs": { "order": 1 },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "Columns match the sample" }]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "Dates are ISO 8601" }]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            { "type": "text", "text": "in UTC", "marks": [{ "type": "strike" }] }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "attrs": { "panelType": "warning" },
          "content": [
            {
              "type": "paragraph",
              "content": [{ "type": "text", "text": "Large exports must stream." }]
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": { "language": "ts" },
          "content": [{ "type": "text", "text": "exportInvoices({ format: \"csv\" });" }]
        },
